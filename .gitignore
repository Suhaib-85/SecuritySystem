# --- 1. Node.js Backend ---
backend/node_modules/
backend/*.pid
backend/*.seed
backend/*.pid.lock

# Built frontend output (Vite regenerates this whole folder on every build).
# Ignore it entirely instead of half of it.
backend/public/

# --- 2. Environment Variables (CRITICAL) ---
# Never commit your database URI or JWT/PI secrets.
*.env
.env
**/.env
.env.*
*.local

# --- 3. Python Virtual Environment ---
# The venv lives at the PROJECT ROOT, so ignore .venv/ at any depth.
.venv/
venv/
__pycache__/
*.pyc

# --- 4. Documentation ---
# NOTE: this excludes your SRS / Vision&Scope PDFs from the repo.
# Remove these two lines if you want those deliverables versioned in Git.
docs/*.txt
docs/*.pdf

# --- 5. AI Models & Large Assets ---
# Model IS committed (only ~6MB, needed to run). Uncomment to exclude it.
# edge_device/model/*.tflite

# --- 6. Media & Evidence ---
# Ignore heavy captured evidence anywhere...
*.mp4
*.webm
*.jpg
# ...but KEEP the sample asset the simulator + tests depend on.
!assets/sample.mp4

# --- 7. Uploads & Temporary Storage ---
# Transient queue/sidecar/staging files in ANY tier.
**/pending_uploads/*.json
**/recordings/*.json
**/temp_uploads/*

# --- 8. React Frontend (Vite) ---
frontend/node_modules/
frontend/dist/
frontend/.vite/

# --- 9. OS & Editor Files ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.sw?

# --- 10. Logs ---
logs/
*.log

# --- 11. Keep empty dirs (MUST be last so it overrides the rules above) ---
!**/.gitkeep
